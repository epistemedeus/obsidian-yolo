      "additionalSettings": {
        "requestTransportMode": "browser"
      }
    }
  ],
  "chatModels": [
    {
      "id": "openai/gpt-5",
      "providerId": "openai",
      "model": "gpt-5",
      "enable": true
    },
    {
      "id": "openai/gpt-5.6-luna",
      "providerId": "openai",
      "model": "gpt-5.6-luna",
      "enable": true,
      "customParameters": [
        {
          "key": "max_tokens",
          "value": "64",
          "type": "number"
        }
      ]
    },
    {
      "id": "openai/gpt-5.6-terra",
      "providerId": "openai",
      "model": "gpt-5.6-terra",
      "enable": false,
      "reasoningType": "openai"
