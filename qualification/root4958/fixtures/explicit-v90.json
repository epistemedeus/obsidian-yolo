      "updatedAt": 1
    },
    {
      "id": "other",
      "name": "Other",
      "modelId": "openai/gpt-5",
      "createdAt": 2,
      "updatedAt": 2
    }
  ],
  "chatOptions": {
    "includeCurrentFileContent": true,
    "reasoningLevelByModelId": {
      "openai/gpt-5.6-luna": "off",
      "openai/gpt-5.6-terra": "high"
    },
    "cliModelIdByRuntime": {
      "codex": "gpt-4.1-nano"
    }
  },
  "mcp": {
    "builtinCapabilityOptions": {
      "subagent_delegation": {
        "allowedModelIds": [
          "openai/gpt-5.6-luna",
          "openai/gpt-5.6-terra",
          "openai/gpt-5"
